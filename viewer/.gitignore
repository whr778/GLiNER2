# Python (backend)
.venv/
__pycache__/
*.pyc

# Node / NextJS (frontend)
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# frontend/lib is source; un-ignore it (the root .gitignore's Python `lib/`
# rule would otherwise swallow the whole directory).
!frontend/lib/
!frontend/lib/**

# runtime (viewer.sh pids + logs)
.run/

# local registries / env
models.json
.env
.env.local
