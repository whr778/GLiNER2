# Python (backend)
.venv/
# uv interpreter pin. Root .gitignore ignores .python-version (pyenv); this
# one must stay. mps-flash-attn==0.6.1 has no cp315 wheel, and an unpinned
# `uv run` rebuilds .venv on Homebrew python3 (3.15) and never starts.
!backend/.python-version
__pycache__/
*.pyc

# Node / NextJS (frontend)
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# frontend/lib is source; un-ignore it (the root .gitignore's Python `lib/`
# rule would otherwise swallow the whole directory).
!frontend/lib/
!frontend/lib/**

frontend/.npm-cache/

# runtime (viewer.sh pids + logs)
.run/

# local registries / env
models.json
config.yaml
.env
.env.local
