# Local training inputs/outputs (large, machine-specific). Root-anchored so
# `tools/data/` (the dataset-converter package) is NOT excluded. Use `/data/*`
# (not `/data/`) so specific small corpora can be re-included below; a whole dir
# can't be re-included once its parent is excluded. Committed tracking-experiment
# data lives OUTSIDE /data/, under /datasets/ (not ignored).
/data/*
!/data/README.md
!/data/synthetic_sonnet5_1k.train.jsonl
!/data/synthetic_sonnet5_1k.val.jsonl
!/data/synthetic_sonnet5_1k.test.jsonl
!/data/casualty_ft.train.jsonl
!/data/casualty_ft.val.jsonl
!/data/casualty_ft.test.jsonl
# The synthetic_haiku45_5k corpora are NOT committed: they live in private HF
# dataset repos and the trainer pulls them on demand (dataset_registry.yaml
# `hf_jsonl`, tools/train/train.py `_fetch_if_missing`).
/raw_data/
/out/


# Personal / per-session notes — not project documentation
/INSTRUCTIONS.md
/.AWS_ENV.md

# From main's boundary / joint-ie work
/docs/boundary_architecture.md
/benchmarks/
# Downloaded / converted training corpora
/data/pile_ner/

/scripts/*
!/scripts/check_public_surface.py
!/scripts/surface_snapshot.py
!/scripts/preflight_gold_capacity.py

# Wayback HTML cache for the Turkiye-Syria validation (derived facts are committed, not article text)
datasets/turkey2023/_cache/

datasets/helene2024/_cache/
datasets/aegean2020/_cache/
datasets/*/real_feed.jsonl
