[{"corpus": "cmnee", "idx": 2138, "n_events": 2, "dup_types": {"Experiment": 2}, "chars": 70, "record": {"input": "12月16日,美国海军约翰・肯尼迪号航母在亨廷顿英格尔斯工业公司纽波特纽斯造船厂下水,将开始进行舾装和测试工作,建造工作比原计划提前3个月。", "output": {"events": [{"event_type": "Experiment", "triggers": ["测试"], "arguments": [{"role": "Date", "entity": "12月16日"}, {"role": "Subject", "entity": "美国海军"}, {"role": "Equipment", "entity": "约翰・肯尼迪号航母"}, {"role": "Location", "entity": "亨廷顿英格尔斯工业公司纽波特纽斯造船厂"}]}, {"event_type": "Experiment", "triggers": ["下水"], "arguments": [{"role": "Date", "entity": "12月16日"}, {"role": "Subject", "entity": "美国海军"}, {"role": "Equipment", "entity": "约翰・肯尼迪号航母"}, {"role": "Location", "entity": "亨廷顿英格尔斯工业公司纽波特纽斯造船厂"}]}]}}}, {"corpus": "cmnee", "idx": 2336, "n_events": 3, "dup_types": {"Experiment": 3}, "chars": 96, "record": {"input": "1月30日,印度在东部海岸试验靶场试射了阿卡什面对空导弹。这是三天内的第三次试射。 导弹使用火箭筒从昌迪普尔海上试验基地发射,成功命中飞行目标。   1月28日,印度曾两次成功试验阿卡什导弹。", "output": {"events": [{"event_type": "Experiment", "triggers": ["试射"], "arguments": [{"role": "Date", "entity": "1月30日"}, {"role": "Subject", "entity": "印度"}, {"role": "Location", "entity": "东部海岸试验靶场"}, {"role": "Equipment", "entity": "阿卡什面对空导弹"}]}, {"event_type": "Experiment", "triggers": ["发射"], "arguments": [{"role": "Subject", "entity": "印度"}, {"role": "Equipment", "entity": "阿卡什面对空导弹"}, {"role": "Location", "entity": "昌迪普尔海上试验基地"}]}, {"event_type": "Experiment", "triggers": ["试验"], "arguments": [{"role": "Date", "entity": "1月28日"}, {"role": "Subject", "entity": "印度"}, {"role": "Equipment", "entity": "阿卡什导弹"}]}]}}}, {"corpus": "cmnee", "idx": 2224, "n_events": 2, "dup_types": {"Experiment": 2}, "chars": 107, "record": {"input": "作为武器系统开发的一部分,印度在5月29日试射了一枚Akash中程地对空导弹,试验取得了成功。 Akash导弹的射程为16英里,是印度国防研究与开发机构研制的,曾进行过几次飞行试验。它的有效载荷能力是110 磅。 ", "output": {"events": [{"event_type": "Experiment", "triggers": ["试验"], "arguments": [{"role": "Subject", "entity": "印度"}, {"role": "Equipment", "entity": "Akash导弹"}]}, {"event_type": "Experiment", "triggers": ["试射"], "arguments": [{"role": "Subject", "entity": "印度"}, {"role": "Date", "entity": "5月29日"}, {"role": "Equipment", "entity": "Akash中程地对空导弹"}]}]}}}, {"corpus": "cmnee", "idx": 2668, "n_events": 2, "dup_types": {"Experiment": 2}, "chars": 110, "record": {"input": "伊朗伊斯兰革命卫队将于本周三在波斯湾测进行伟大先知6号 第二阶段的导弹演习,测试最新的超声速面对海导弹。 据介绍,在为期10天的第一阶段导弹演习中,伊朗陆军发射、测试了14枚面对面导弹和法塔赫-110型中程弹道导弹 。 ", "output": {"events": [{"event_type": "Experiment", "triggers": ["测试"], "arguments": [{"role": "Subject", "entity": "伊朗伊斯兰革命卫队"}, {"role": "Date", "entity": "本周三"}, {"role": "Location", "entity": "波斯湾"}, {"role": "Equipment", "entity": "超声速面对海导弹"}]}, {"event_type": "Experiment", "triggers": ["测试"], "arguments": [{"role": "Subject", "entity": "伊朗陆军"}, {"role": "Equipment", "entity": "面对面导弹"}, {"role": "Equipment", "entity": "法塔赫-110型中程弹道导弹"}]}]}}}, {"corpus": "cmnee", "idx": 1784, "n_events": 2, "dup_types": {"Experiment": 2}, "chars": 113, "record": {"input": "印度首艘本土建造的歼敌者号核潜艇将在2~3周内启动核反应堆,向完成海试更进一步。 印度国防研究与发展组织总监萨拉斯沃特表示,目前歼敌者号正在维沙卡帕特南潜艇基地进行测试,在核反应堆启动之后,将下水开始海试,以对反应堆进行测试。", "output": {"events": [{"event_type": "Experiment", "triggers": ["海试"], "arguments": [{"role": "Subject", "entity": "印度"}, {"role": "Equipment", "entity": "歼敌者号"}]}, {"event_type": "Experiment", "triggers": ["测试"], "arguments": [{"role": "Subject", "entity": "印度"}, {"role": "Equipment", "entity": "歼敌者号"}, {"role": "Location", "entity": "维沙卡帕特南潜艇基地"}]}]}}}, {"corpus": "cmnee", "idx": 768, "n_events": 3, "dup_types": {"Deploy": 2}, "chars": 115, "record": {"input": "美国国防部计划于下周在太平洋上空进行全国导弹防域系统的第二次拦截测试。又讯:美国国防部官员11日�,克林顿总统有意要求国会,在他所提2001财政年度预算中增加22亿美元全国导弹防域经费,主要为加强拦截导弹部署阿拉斯加或北达科他州。", "output": {"events": [{"event_type": "Deploy", "triggers": ["部署"], "arguments": [{"role": "Subject", "entity": "美国国防部"}, {"role": "Militaryforce", "entity": "拦截导弹"}, {"role": "Location", "entity": "阿拉斯加"}]}, {"event_type": "Deploy", "triggers": ["部署"], "arguments": [{"role": "Subject", "entity": "美国国防部"}, {"role": "Militaryforce", "entity": "拦截导弹"}, {"role": "Location", "entity": "北达科他州"}]}, {"event_type": "Experiment", "triggers": ["测试"], "arguments": [{"role": "Subject", "entity": "美国国防部"}, {"role": "Date", "entity": "下周"}, {"role": "Location", "entity": "太平洋上空"}, {"role": "Equipment", "entity": "全国导弹防域系统"}]}]}}}, {"corpus": "cmnee", "idx": 2258, "n_events": 2, "dup_types": {"Experiment": 2}, "chars": 121, "record": {"input": "据华声报5月15日报道:印度星期日在南部海面一艘军舰上,试射舰对空三叉戟导弹,取得成功。印度国防部长称,在5月22日把此类型导弹装备海军前,还会进行类似试射。据悉自1983年以来三叉戟导弹试射已超过九次。目前印度还在积极开发地对空三叉戟导弹。", "output": {"events": [{"event_type": "Experiment", "triggers": ["试射"], "arguments": [{"role": "Subject", "entity": "印度"}, {"role": "Date", "entity": "1983年以来"}, {"role": "Equipment", "entity": "三叉戟导弹"}]}, {"event_type": "Experiment", "triggers": ["试射"], "arguments": [{"role": "Subject", "entity": "印度"}, {"role": "Date", "entity": "星期日"}, {"role": "Location", "entity": "南部海面"}, {"role": "Equipment", "entity": "军舰"}, {"role": "Equipment", "entity": "舰对空三叉戟导弹"}]}]}}}, {"corpus": "cmnee", "idx": 2183, "n_events": 2, "dup_types": {"Experiment": 2}, "chars": 123, "record": {"input": "俄罗斯国防部12月11日报道,22350型戈尔什科夫上将号护卫舰从白海试射了一枚锆石高超声速导弹,导弹飞行距离超过350千米,速度超过马赫数8,成功击中阿尔汉格尔斯克地区北部奇扎靶场的沿海目标。据报道,俄罗斯于2015年开始对该导弹进行飞行试验。", "output": {"events": [{"event_type": "Experiment", "triggers": ["试射"], "arguments": [{"role": "Equipment", "entity": "22350型戈尔什科夫上将号护卫舰"}, {"role": "Location", "entity": "白海"}, {"role": "Equipment", "entity": "锆石高超声速导弹"}, {"role": "Subject", "entity": "俄罗斯"}]}, {"event_type": "Experiment", "triggers": ["试验"], "arguments": [{"role": "Equipment", "entity": "锆石高超声速导弹"}, {"role": "Subject", "entity": "俄罗斯"}, {"role": "Date", "entity": "2015年开始"}]}]}}}, {"corpus": "cmnee", "idx": 2118, "n_events": 3, "dup_types": {"Experiment": 3}, "chars": 126, "record": {"input": "巴西海军于2019年7月10日成功试射了第三枚自研反舰导弹原型弹,验证了导弹自2018年11月和2019年3月两次试验后的相关改进。本次试验进行了额外的检查,并通过安装在导弹内和作战船只上的遥测装置进行了记录,获得的信息将用于组件和子系统的进一步改进。", "output": {"events": [{"event_type": "Experiment", "triggers": ["试验"], "arguments": [{"role": "Subject", "entity": "巴西海军"}, {"role": "Equipment", "entity": "自研反舰导弹原型弹"}, {"role": "Date", "entity": "2019年3月"}]}, {"event_type": "Experiment", "triggers": ["试验"], "arguments": [{"role": "Subject", "entity": "巴西海军"}, {"role": "Equipment", "entity": "自研反舰导弹原型弹"}, {"role": "Date", "entity": "2018年11月"}]}, {"event_type": "Experiment", "triggers": ["试射"], "arguments": [{"role": "Subject", "entity": "巴西海军"}, {"role": "Date", "entity": "2019年7月10日"}, {"role": "Equipment", "entity": "自研反舰导弹原型弹"}]}]}}}, {"corpus": "cmnee", "idx": 2479, "n_events": 2, "dup_types": {"Experiment": 2}, "chars": 132, "record": {"input": "来自韩国6月2日的消息称,发现朝鲜正准备在其东西海岸试射一些弹道导弹,使该地区的紧张局势自朝鲜5月25日宣布进行第二次核试验后更加紧张。韩国一位立法者援引防务官员的话称,朝鲜于5月25日进行了第二次地下核爆炸后,显然已将一枚洲际弹道导弹运输到其西海岸的一个发射场。", "output": {"events": [{"event_type": "Experiment", "triggers": ["试射"], "arguments": [{"role": "Subject", "entity": "朝鲜"}, {"role": "Location", "entity": "东西海岸"}, {"role": "Equipment", "entity": "弹道导弹"}]}, {"event_type": "Experiment", "triggers": ["试验"], "arguments": [{"role": "Subject", "entity": "朝鲜"}, {"role": "Date", "entity": "5月25日"}, {"role": "Equipment", "entity": "核"}]}]}}}, {"corpus": "cmnee", "idx": 2264, "n_events": 2, "dup_types": {"Experiment": 2}, "chars": 136, "record": {"input": "俄罗斯海军3月16日成功试射两枚洲际弹道导弹。 这两枚洲际弹道导弹是从行驶在巴伦支海的Novomoskovsk核潜艇上发射的,导弹经过几个小时的飞行后击中了位于俄罗斯远东地区的勘察加半岛上的目标。 在今年2月俄罗斯军事演习期间,俄罗斯进行过两次相同的试验,结果以失败告终。", "output": {"events": [{"event_type": "Experiment", "triggers": ["试射"], "arguments": [{"role": "Subject", "entity": "俄罗斯海军"}, {"role": "Date", "entity": "3月16日"}, {"role": "Equipment", "entity": "洲际弹道导弹"}, {"role": "Location", "entity": "巴伦支海"}, {"role": "Equipment", "entity": "Novomoskovsk核潜艇"}]}, {"event_type": "Experiment", "triggers": ["试验"], "arguments": [{"role": "Equipment", "entity": "洲际弹道导弹"}, {"role": "Equipment", "entity": "Novomoskovsk核潜艇"}, {"role": "Date", "entity": "今年2月"}, {"role": "Subject", "entity": "俄罗斯"}]}]}}}, {"corpus": "cmnee", "idx": 2259, "n_events": 2, "dup_types": {"Experiment": 2}, "chars": 141, "record": {"input": "据《华声报》5月15日报道,印度星期日在南部海面一艘军舰上,试射舰对空三叉戟导弹,取得成功。印度国防部长称,在这种导弹装备海军前,当局还会进行类似试射。自1983年以来三叉戟舰对空导弹已试射逾九次,研究人员目前正开发地对空三叉戟导弹。印度计划建立包括火式弹道导弹在内的整个导弹系列。", "output": {"events": [{"event_type": "Experiment", "triggers": ["试射"], "arguments": [{"role": "Subject", "entity": "印度"}, {"role": "Date", "entity": "星期日"}, {"role": "Location", "entity": "南部海面"}, {"role": "Equipment", "entity": "军舰"}, {"role": "Equipment", "entity": "舰对空三叉戟导弹"}]}, {"event_type": "Experiment", "triggers": ["试射"], "arguments": [{"role": "Subject", "entity": "印度国防部"}, {"role": "Date", "entity": "1983年"}, {"role": "Equipment", "entity": "三叉戟舰对空导弹"}]}]}}}]